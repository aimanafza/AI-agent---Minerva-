# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Slack: create an app at api.slack.com/apps, add bot scopes:
#   channels:history, channels:read, chat:write
# Install to workspace, invite the bot to your #bugs channel (/invite @triage)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXX

# Linear: Settings > API > Personal API key
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_KEY=ENG

# GitHub: fine-grained token with repo read access to the demo repo
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-org/your-demo-repo

# Map GitHub logins -> Linear user emails (who the agent may assign to)
# JSON, single line
USER_MAP={"priya-gh":"priya@team.dev","aiman-gh":"aiman@team.dev"}

# Watcher: minutes before an unassigned/untouched P1 escalates (2h in prod, 2min for demo)
ESCALATE_AFTER_MIN=2
WATCH_INTERVAL_SEC=30
# A label generating this many bugs in 7 days triggers a component-health ping
HEAT_THRESHOLD=4

# Notion (optional): the current-cycle priorities page. When set, Mamdani reads
# it and weighs bug priority against the cycle focus, citing the page.
# Integration token: notion.so/profile/integrations -> new internal integration.
# Then on the page: ... menu -> Connections -> add your integration.
# Page ID: the 32-hex-char tail of the page URL.
NOTION_API_KEY=
NOTION_PAGE_ID=

# true: the agent posts its triage proposal in the thread and waits for a human
# to reply "approve" (or "reject") before filing. false: auto-file.
REQUIRE_APPROVAL=true
